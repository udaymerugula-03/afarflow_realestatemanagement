# Cloud-only application. Configure actual values in Vercel, not in Git.
# DATABASE_URL=postgresql://YOUR_HOSTED_POSTGRES/aqarflow?sslmode=verify-full
# SECRET_KEY=GENERATE_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# BLOB_STORE_ID=store_YOUR_VERCEL_BLOB_STORE
# Vercel supplies rotating OIDC credentials for the connected Blob store.
# BLOB_READ_WRITE_TOKEN=YOUR_TOKEN_ONLY_FOR_ADMINISTRATIVE_TOOLING_OUTSIDE_VERCEL
# PUBLIC_API_URL=https://YOUR_PROJECT.vercel.app
# FRONTEND_ORIGINS=https://YOUR_PROJECT.vercel.app
#
# Administrative CLI only: seed a NEW EMPTY hosted database, never the existing deployment.
# ADMIN_EMAIL=YOUR_ADMIN_EMAIL
# AGENT_EMAIL=YOUR_AGENT_EMAIL
# CREDENTIALS_FILE=.demo-credentials.cloud.json

# Optional: leave DATABASE_URL unset to use local embedded PostgreSQL (PGlite).
# Uncomment and fill this only when connecting to a PostgreSQL server.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aqarflow
# SECRET_KEY=
# FRONTEND_ORIGINS=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000
# UPLOAD_DIR=uploads
# PGLITE_DIR=.data
# PORT=8000

# Deployment: use hosted PostgreSQL, a stable signing key and persistent photo storage.
# Never enable the local PGlite database on Vercel.
# BLOB_STORE_ID=store_YOUR_VERCEL_BLOB_STORE
# Vercel provides OIDC credentials automatically for a connected Blob store.
# BLOB_READ_WRITE_TOKEN=YOUR_TOKEN_ONLY_IF_USING_BLOB_OUTSIDE_VERCEL
# PUBLIC_API_URL=https://YOUR_PROJECT.vercel.app
# FRONTEND_ORIGINS=https://YOUR_PROJECT.vercel.app
# Cloud seeding can write a separate ignored credential file:
# DEMO_CREDENTIALS_FILE=.demo-credentials.cloud.json

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "installCommand": "npm ci --prefix frontend && npm ci --prefix backend",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/{migrations/**,node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/openapi.json", "destination": "/api" },
    { "source": "/docs/:path*", "destination": "/api" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/properties/:path*", "destination": "/index.html" },
    { "source": "/workspace/:path*", "destination": "/index.html" },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/index.html"
    }
  ]
}
